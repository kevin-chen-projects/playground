import { GameState } from "./types";

// Very small state engine placeholder.
// We'll add transition logic for puzzle attempts.

export function createInitialState(startRoomId: string): GameState {
  return {
    currentRoomId: startRoomId,
    inventoryItemIds: [],
    solvedPuzzleIds: [],
  };
}

export function markPuzzleSolved(state: GameState, puzzleId: string): GameState {
  if (state.solvedPuzzleIds.includes(puzzleId)) return state;
  return {
    ...state,
    solvedPuzzleIds: [...state.solvedPuzzleIds, puzzleId],
  };
}
