<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Guitar MP3 Transcription</title>\n  <style>\n    :root {\n      --bg: #07111f;\n      --panel: #101b2f;\n      --panel2: #172540;\n      --text: #e7eeff;\n      --muted: #a9b6d3;\n      --accent: #79a8ff;\n      --accent2: #74e0b8;\n      --border: rgba(255,255,255,0.1);\n      --danger: #ff8aa1;\n    }\n    * { box-sizing: border-box; }\n    body {\n      margin: 0;\n      font-family: Inter, system-ui, Arial, sans-serif;\n      color: var(--text);\n      background: radial-gradient(circle at top, #14264b 0%, var(--bg) 55%);\n    }\n    .wrap { max-width: 1100px; margin: 0 auto; padding: 28px 20px 44px; }\n    .hero, .card {\n      border: 1px solid var(--border);\n      border-radius: 18px;\n      background: rgba(16,27,47,0.78);\n      box-shadow: 0 24px 80px rgba(0,0,0,0.3);\n    }\n    .hero { padding: 28px; }\n    h1 { margin: 0 0 10px; font-size: clamp(2rem, 4vw, 3.2rem); }\n    h2 { margin-top: 0; }\n    p, li { color: var(--muted); line-height: 1.6; }\n    .grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 20px; margin-top: 22px; }\n    @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }\n    .card { padding: 20px; }\n    .dropzone {\n      padding: 28px;\n      border-radius: 16px;\n      border: 1.5px dashed rgba(121,168,255,0.7);\n      text-align: center;\n      background: rgba(23,37,64,0.7);\n    }\n    .dropzone.dragover { border-color: var(--accent2); background: rgba(116,224,184,0.1); }\n    .row { display: grid; gap: 12px; margin-top: 16px; }\n    label { display: grid; gap: 7px; color: var(--muted); font-size: 0.95rem; }\n    input, select, button {\n      width: 100%;\n      border-radius: 12px;\n      border: 1px solid var(--border);\n      background: var(--panel2);\n      color: var(--text);\n      padding: 12px 14px;\n      font: inherit;\n    }\n    button {\n      border: none;\n      cursor: pointer;\n      background: linear-gradient(135deg, var(--accent), #8a63ff);\n      font-weight: 700;\n    }\n    button.secondary {\n      background: rgba(255,255,255,0.06);\n      border: 1px solid var(--border);\n    }\n    .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }\n    .status, .result {\n      margin-top: 16px;\n      padding: 14px;\n      border-radius: 14px;\n      border: 1px solid var(--border);\n      background: rgba(255,255,255,0.04);\n      white-space: pre-wrap;\n    }\n    .hidden { display: none; }\n    .ok { color: #9bf0cb; }\n    .error { color: var(--danger); }\n    a { color: #b7c8ff; }\n    .pillrow { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }\n    .pill {\n      font-size: 0.9rem;\n      padding: 7px 12px;\n      border-radius: 999px;\n      background: rgba(121,168,255,0.14);\n      border: 1px solid rgba(121,168,255,0.28);\n    }\n    ul { padding-left: 20px; }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\">\n    <section class=\"hero\">\n      <h1>Guitar MP3 → PDF Score/Tab</h1>\n      <p>\n        Upload an MP3 of guitar music and generate a chord-aware guitar score/tab PDF.\n        This app is tuned for guitar input, with simultaneous note grouping to better represent chords.\n      </p>\n      <div class=\"pillrow\">\n        <span class=\"pill\">Polyphonic note detection</span>\n        <span class=\"pill\">Chord event grouping</span>\n        <span class=\"pill\">Guitar fretboard mapping</span>\n        <span class=\"pill\">PDF export</span>\n      </div>\n    </section>\n\n    <div class=\"grid\">\n      <section class=\"card\">\n        <div id=\"dropzone\" class=\"dropzone\">\n          <strong>Drop an MP3 here</strong>\n          <p>or select a file</p>\n          <input id=\"audioFile\" type=\"file\" accept=\"audio/mpeg,audio/mp3\" />\n        </div>\n\n        <div class=\"row\">\n          <label>\n            Tuning\n            <select id=\"tuning\">\n              <option value=\"standard\">Standard EADGBE</option>\n              <option value=\"drop-d\">Drop D</option>\n              <option value=\"dadgad\">DADGAD</option>\n              <option value=\"open-g\">Open G</option>\n            </select>\n          </label>\n\n          <label>\n            Detail mode\n            <select id=\"detail\">\n              <option value=\"fast\">Fast sketch</option>\n              <option value=\"balanced\" selected>Balanced</option>\n              <option value=\"deep\">Deep chord-aware</option>\n            </select>\n          </label>\n\n          <label>\n            Output PDF filename\n            <input id=\"filename\" type=\"text\" value=\"guitar-transcription.pdf\" />\n          </label>\n        </div>\n\n        <div class=\"actions\">\n          <button id=\"transcribeBtn\">Generate PDF</button>\n          <button id=\"demoBtn\" class=\"secondary\">Load demo settings</button>\n        </div>\n\n        <div id=\"status\" class=\"status\">Ready.</div>\n        <div id=\"result\" class=\"result hidden\"></div>\n      </section>\n\n      <aside class=\"card\">\n        <h2>What this app does</h2>\n        <ul>\n          <li>Extracts multiple simultaneous pitches from guitar MP3 audio</li>\n          <li>Groups overlapping notes into chord-like events</li>\n          <li>Maps pitches onto plausible guitar string/fret positions</li>\n          <li>Exports a printable PDF arrangement with simple notation + tab</li>\n        </ul>\n        <p>\n          Best results come from relatively isolated guitar recordings. Dense mixes, effects, and overlapping instruments reduce transcription accuracy.\n        </p>\n      </aside>\n    </div>\n  </div>\n\n  <script>\n    const API_BASE = 'http://127.0.0.1:8000';\n    const fileInput = document.getElementById('audioFile');\n    const dropzone = document.getElementById('dropzone');\n    const transcribeBtn = document.getElementById('transcribeBtn');\n    const demoBtn = document.getElementById('demoBtn');\n    const tuning = document.getElementById('tuning');\n    const detail = document.getElementById('detail');\n    const filename = document.getElementById('filename');\n    const statusEl = document.getElementById('status');\n    const resultEl = document.getElementById('result');\n\n    let selectedFile = null;\n\n    function setStatus(msg, cls = '') {\n      statusEl.className = 'status ' + cls;\n      statusEl.textContent = msg;\n    }\n\n    function renderResult(data) {\n      resultEl.classList.remove('hidden');\n      resultEl.innerHTML = `\n        <strong>Transcription complete</strong><br><br>\n        Title: ${data.title}<br>\n        Notes detected: ${data.notes_detected}<br>\n        Chord events: ${data.chord_events}<br>\n        Tuning: ${data.tuning}<br>\n        Detail: ${data.detail}<br><br>\n        <a href=\"${API_BASE}${data.pdf_url}\" target=\"_blank\" rel=\"noreferrer\">Open PDF</a><br>\n        <a href=\"${API_BASE}${data.json_url}\" target=\"_blank\" rel=\"noreferrer\">Open JSON</a><br><br>\n        <strong>Warnings</strong>\n        <ul>${(data.warnings || []).map(w => `<li>${w}</li>`).join('')}</ul>\n      `;\n    }\n\n    function chooseFile(file) {\n      if (!file) return;\n      if (!file.name.toLowerCase().endsWith('.mp3')) {\n        setStatus('Please choose an MP3 file.', 'error');\n        return;\n      }\n      selectedFile = file;\n      setStatus(`Selected: ${file.name}`, 'ok');\n    }\n\n    fileInput.addEventListener('change', (e) => chooseFile(e.target.files[0]));\n    ['dragenter', 'dragover'].forEach(evt => {\n      dropzone.addEventListener(evt, e => {\n        e.preventDefault();\n        dropzone.classList.add('dragover');\n      });\n    });\n    ['dragleave', 'drop'].forEach(evt => {\n      dropzone.addEventListener(evt, e => {\n        e.preventDefault();\n        dropzone.classList.remove('dragover');\n      });\n    });\n    dropzone.addEventListener('drop', (e) => chooseFile(e.dataTransfer.files[0]));\n\n    demoBtn.addEventListener('click', () => {\n      tuning.value = 'standard';\n      detail.value = 'balanced';\n      filename.value = 'guitar-transcription.pdf';\n      setStatus('Demo settings loaded.', 'ok');\n    });\n\n    transcribeBtn.addEventListener('click', async () => {\n      if (!selectedFile) {\n        setStatus('Upload an MP3 first.', 'error');\n        return;\n      }\n\n      resultEl.classList.add('hidden');\n      setStatus('Uploading and transcribing... this may take a while for larger MP3 files.');\n      transcribeBtn.disabled = true;\n\n      try {\n        const form = new FormData();\n        form.append('file', selectedFile);\n        form.append('tuning', tuning.value);\n        form.append('detail', detail.value);\n        form.append('filename', filename.value || 'guitar-transcription.pdf');\n\n        const res = await fetch(`${API_BASE}/api/transcribe`, {\n          method: 'POST',\n          body: form,\n        });\n\n        const data = await res.json();\n        if (!res.ok) throw new Error(data.detail || 'Transcription failed');\n\n        setStatus('Done. PDF and JSON outputs are ready.', 'ok');\n        renderResult(data);\n      } catch (err) {\n        setStatus(`Error: ${err.message}`, 'error');\n      } finally {\n        transcribeBtn.disabled = false;\n      }\n    });\n  </script>\n</body>\n</html>\n